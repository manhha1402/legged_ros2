<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="g1">

  <xacro:arg name="prefix" default="" />
  <xacro:arg name="network_interface" default="lo" />
  <xacro:arg name="use_sim" default="true" />

  <xacro:include filename="$(find g1_description)/urdf/g1_29dof_lock_waist_rev_1_0_macro.urdf.xacro" />
  
  <xacro:include filename="$(find g1_description)/urdf/g1_29dof_lock_waist_rev_1_0.ros2_control.xacro" />

  <xacro:g1 prefix="$(arg prefix)" />

  <xacro:g1_ros2_control 
    prefix="$(arg prefix)" 
    network_interface="$(arg network_interface)"
    use_sim="$(arg use_sim)"/>

</robot>
